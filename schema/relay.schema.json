{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ajdhoward/acidwurx-ai-bridge/schema/relay.schema.json",
  "title": "AI Relay Proposal Front Matter",
  "description": "Validation schema for YAML front matter of AI output relays landing in proposals/ and checkpoints/. Payload body is data-only and is never executed.",
  "type": "object",
  "required": ["task_id", "provider", "account_slot", "status", "next_action", "confidence"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(T-[0-9]{4}|S0-T[0-9]+)$"
    },
    "provider": {
      "type": "string",
      "enum": ["google-ai-search", "qwen", "meta-ai", "kimi", "claude", "opencode-local"]
    },
    "account_slot": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-acct-[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "PARTIAL", "BLOCKED"]
    },
    "tokens_in_est": { "type": "integer", "minimum": 0 },
    "tokens_out_est": { "type": "integer", "minimum": 0 },
    "quota_state": {
      "type": "string",
      "enum": ["AVAILABLE", "NEAR_LIMIT", "EXHAUSTED_COOLDOWN"]
    },
    "reset_hint_utc": { "type": "string" },
    "next_action": {
      "type": "string",
      "enum": ["CONTINUE", "REASSIGN_NEXT_ACCOUNT", "REVIEW"]
    },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 10 },
    "alias_of": { "type": "string" }
  },
  "additionalProperties": true
}
